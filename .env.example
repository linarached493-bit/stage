# Copier ce fichier en ".env" et adapter les valeurs pour l'environnement local.
# Aucune valeur réelle ne doit être commise dans le dépôt (voir .gitignore).

# --- Application ---
APP_ENV=development

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173

# --- Base de données (PostgreSQL) ---
POSTGRES_USER=ccm_ids
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ccm_ids
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ccm_ids:change-me@db:5432/ccm_ids
